---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Blog | Editsandgo.">
  <section class="blog-grid-container">
    <h1 class="blog-main-title">Nuestro Blog</h1>

    <div class="blog-grid">
      <!-- Entrada 1 -->
      <article class="blog-card">
        <a href="/blog/entrada-1" class="blog-link">
          <img src="/imagenes/5errores.webp" alt="5 errores comunes al autopublicar tu novela" class="blog-img" loading="lazy" />
          <h2 class="blog-title">5 errores comunes al autopublicar tu novela</h2>
          <p class="blog-date">25 julio 2025</p>
        </a>
      </article>

      <!-- Entrada 2 -->
      <article class="blog-card">
        <a href="/blog/entrada-2" class="blog-link">
          <img src="/imagenes/buenamaquetacion.webp" alt="¿Por qué una buena maquetación es clave para tu libro?" class="blog-img" loading="lazy" />
          <h2 class="blog-title">¿Por qué una buena maquetación es clave para tu libro?</h2>
          <p class="blog-date">20 julio 2025</p>
        </a>
      </article>

      <!-- Entrada 3 -->
      <article class="blog-card">
        <a href="/blog/entrada-3" class="blog-link">
          <img src="/imagenes/revisar.webp" alt="¿Crees que corregir es lo mismo que revisar?" class="blog-img" loading="lazy" />
          <h2 class="blog-title">¿Crees que corregir es lo mismo que revisar?</h2>
          <p class="blog-date">15 julio 2025</p>
        </a>
      </article>
    </div>
  </section>

  <!-- Enlace al script solo para el blog -->
  <script src="/Scripts/Blog.js" defer></script>
</BaseLayout>

