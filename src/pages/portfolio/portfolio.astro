---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { galeria } from '../../data/galeria.js';
---

<BaseLayout title="portfolio | Editsandgo.">
  <blockquote class="portfolio-quote">
    <p>"Cada portada cuenta una historia. 
      Estas son solo algunas ideas de lo que tu libro podría ser."</p>
  </blockquote>

  <div class="portfolio-grid">
    {galeria.map((book) => (
      <a href={book.href} class="book-card">
        <div class="book-image-container">
          <img src={book.img} alt={book.alt} />
          <div class="book-overlay">
            <h2>{book.title}</h2>
            <p>{book.author}</p>
          </div>
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
