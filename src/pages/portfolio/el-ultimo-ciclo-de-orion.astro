---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookFicha from '../../components/BookFicha.astro';
import ImageModal from '../../components/ImageModal.astro';

const libro = {
  title: "El último ciclo de Orión",
  author: "Raúl Mena",
  description: `Año 4210. La Tierra ya no es planeta madre, sino colonia industrial bajo dominio del Sindicato Interestelar. Los humanos, simples “habitantes útiles”.
Pero algo se mueve en el borde de la galaxia: una nave desaparecida hace siglos ha sido detectada. Y su comandante —una IA defectuosa llamada KERA— contiene secretos que podrían liberar… o destruir a toda la especie.
Tass, una contrabandista con pasado militar, recibe la misión de interceptarla. Lo que no sabe es que la nave la espera a ella.
Y que el ciclo está a punto de reiniciarse.`,
  details: [
    { label: "Autor", value: "Raúl Mena" },
    { label: "Edad lectura", value: "+18 años" },
    { label: "Dimensiones", value: "14.5 x 4.1 x 22.5 cm" },
    { label: "Género", value: "Ciencia ficción / space opera / thriller galáctico" }
  ],
  imagenes: [
    "/imagenes/portada3recortada.webp",
    "/imagenes/orionmaquet.webp",
    "/imagenes/orionmaquet1.webp",
    "/imagenes/orionmaquet2.webp",
    "/imagenes/orionmaquet3.webp",
    "/imagenes/orionmaquet4.webp"
  ],
  maquetacion: {
    original: "/imagenes/manuscritoorion.webp",
    final: "/imagenes/maquetacionorion.webp"
  }
};
---

<BaseLayout title={`${libro.title} | Editsandgo.`}>
  <BookFicha {...libro} />
  <ImageModal />

  <!-- Aquí solo llamamos al script externo -->
  <script src="/scripts/galeriaFicha.js" defer></script>
</BaseLayout>
