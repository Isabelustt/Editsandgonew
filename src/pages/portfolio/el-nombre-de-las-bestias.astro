---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookFicha from '../../components/BookFicha.astro';
import ImageModal from '../../components/ImageModal.astro';

const libro = {
  title: "El nombre de las bestias",
  author: "Luz Ayestarán",
  description: `En el Valle de las Lenguas Olvidadas, cada niño recibe un nombre que no puede decirse en voz alta. Es su escudo, pero también su condena.
Al cumplir catorce años, Ela rompe la tradición: pronuncia su nombre y con él, despierta a las Bestias del Silencio: criaturas que devoran palabras, recuerdos y personas.
Exiliada, perseguida por la Orden de la Voz, y acompañada solo por un muchacho que ha olvidado quién es, Ela deberá recuperar los nombres prohibidos y enfrentarse a la verdad que su pueblo lleva siglos callando.`,
  details: [
    { label: "Autor", value: "Luz Ayestarán" },
    { label: "Edad lectura", value: "+18 años" },
    { label: "Dimensiones", value: "14.5 x 4.1 x 22.5 cm" },
    { label: "Género", value: "Fantasía juvenil / oscura / coming-of-age" }
  ],
  imagenes: [
    "/imagenes/portada2recortada.webp",
    "/imagenes/nombrebestiasmaquet.webp",
    "/imagenes/nombrebestiasmaquet1.webp",
    "/imagenes/nombrebestiasmaquet2.webp",
    "/imagenes/nombrebestiasmaquet3.webp",
    "/imagenes/nombrebestiasmaquet4.webp"
  ],
  maquetacion: {
    original: "/imagenes/manuscritobestias.webp",
    final: "/imagenes/maquetacionbestias.webp"
  }
};
---

<BaseLayout title={`${libro.title} | Editsandgo.`}>
  <BookFicha {...libro} />
  <ImageModal />

  <!-- Aquí solo llamamos al script externo -->
  <script src="/scripts/galeriaFicha.js" defer></script>
</BaseLayout>
