---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookFicha from '../../components/BookFicha.astro';
import ImageModal from '../../components/ImageModal.astro';

const libro = {
  title: "La última coartada",
  author: "Alonso Colina",
  description: `Un juez retirado. Un crimen sin pruebas. Y una coartada que no aguanta ni media página.
Cuando el cadáver de una joven aparece en un viejo teatro de barrio, todas las pistas apuntan a Álvaro Olmos, exmagistrado y hombre intachable. Pero lo que parecía un caso sencillo se convierte en una red de mentiras, favores enterrados y justicia torcida.
A medida que la investigación avanza, alguien mueve los hilos desde las sombras. Y Álvaro tendrá que decidir: ¿seguir el juego o romper las reglas que juró defender?
Una novela que no da tregua. Cuando crees saberlo todo, cambia la pregunta.`,
  details: [
    { label: "Autor", value: "Alonso Colina" },
    { label: "Edad lectura", value: "+18 años" },
    { label: "Dimensiones", value: "14.5 x 4.1 x 22.5 cm" },
    { label: "Género", value: "Thriller policial" }
  ],
  imagenes: [
    "/imagenes/portada4recortada.webp",
    "/imagenes/coartadamaquet.webp",
    "/imagenes/coartadamaquet1.webp",
    "/imagenes/coartadamaquet2.webp",
    "/imagenes/coartadamaquet3.webp",
    "/imagenes/coartadamaquet4.webp"
  ],
  maquetacion: {
    original: "/imagenes/manuscritocoartada.webp",
    final: "/imagenes/maquetacioncoartada.webp"
  }
};
---

<BaseLayout title={`${libro.title} | Editsandgo.`}>
  <BookFicha {...libro} />
  <ImageModal />

  <!-- Aquí solo llamamos al script externo -->
  <script src="/scripts/galeriaFicha.js" defer></script>
</BaseLayout>
